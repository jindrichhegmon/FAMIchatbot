# --- povinné ---
ANTHROPIC_API_KEY=sk-ant-...

# --- model a generování ---
ANTHROPIC_MODEL=claude-sonnet-5
MAX_TOKENS=1024
# TEMPERATURE nenastavovat u Sonnet 5 a novějších (parametr je zrušený); u starších modelů např. 0.4
# TEMPERATURE=

# --- server ---
PORT=3000
# Originy, ze kterých smí widget volat API (čárkou oddělené). Pro famicura.cz:
ALLOWED_ORIGINS=https://www.famicura.cz,https://famicura.cz
# Kam vede tlačítko "Najít poskytovatele" v kartě doporučení.
# Placeholdery: {serviceCode} {regionId} {regionName}
FAMICURA_PROVIDER_URL=https://famicura.cz/?service={serviceCode}&region={regionId}
FAMICURA_HOME_URL=https://www.famicura.cz

# --- sessions / limity ---
SESSION_TTL_MIN=60
MAX_HISTORY_MESSAGES=40
MAX_USER_CHARS=2000
RATE_LIMIT_PER_MIN=30

# --- logování konverzací (JSONL do LOG_DIR, jeden soubor na den) ---
LOG_CONVERSATIONS=true
LOG_DIR=./logs

# --- vývoj bez API klíče ---
MOCK=0

# Uvítací zpráva (volitelné, jinak výchozí text z config.js)
# WELCOME_MESSAGE=Dobrý den, jsem asistentka Fami...
